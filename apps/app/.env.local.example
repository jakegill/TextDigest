# Base URL of the api (GCP API Gateway in deployed stages, localhost in dev).
# Inlined at build time — must start with NEXT_PUBLIC_ to be available in the
# static export.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Firebase Auth client config — values come from infra/auth.ts at build time
# in normal flows. Only set these manually if running `next dev` outside of
# `pnpm dev <stage>` (which injects them via the WebApp DevCommand).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
