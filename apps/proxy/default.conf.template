server {
  listen ${PORT};
  resolver 8.8.8.8 ipv6=off;

  proxy_http_version 1.1;
  proxy_set_header Host storage.googleapis.com;
  proxy_ssl_server_name on;
  proxy_intercept_errors on;
  recursive_error_pages on;

  rewrite ^/(.+)/$ /$1 last;

  location = / {
    proxy_pass https://storage.googleapis.com/${BUCKET}/index.html;
  }

  location / {
    error_page 404 = @html;
    proxy_pass https://storage.googleapis.com/${BUCKET}$uri;
  }

  location @html {
    error_page 404 = @index;
    proxy_pass https://storage.googleapis.com/${BUCKET}$uri.html;
  }

  location @index {
    proxy_pass https://storage.googleapis.com/${BUCKET}$uri/index.html;
  }
}
